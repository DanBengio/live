{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "live-build",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "live-build-baratextile",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js",
        "--port",
        "3200"
      ],
      "port": 3200,
      "env": {
        "PUBLIC_URL": "https://sondage.baratextile.com"
      }
    }
  ]
}
