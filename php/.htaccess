# Live — configuration Apache pour hébergement mutualisé (Infomaniak)
Options -Indexes
AddDefaultCharset utf-8

RewriteEngine On
RewriteBase /

# L'API passe par un seul fichier PHP
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# Fichiers réels (site construit, JSON statiques) : servis tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste : l'application (routes /host/…, /join/…, /p/…)
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Les JSON changent en permanence : le navigateur revalide à chaque fois (ETag → 304)
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Les fichiers construits portent une empreinte dans leur nom : cache long
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
