# Colle ici la config Firebase (console Firebase > Paramètres du projet > Vos applications > Config)
# Sans ces variables, l'app tourne en mode local (démo, un seul navigateur).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend : laisser vide = serveur HTTP (server/index.js). Valeurs possibles : local, firebase
VITE_BACKEND=
