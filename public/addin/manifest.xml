<?xml version="1.0" encoding="UTF-8"?>
<!-- Module PowerPoint « Live » : affiche une activité Live dans une diapo -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>84c365e6-a511-440e-8849-ace119baf7eb</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Live</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Live" />
  <Description DefaultValue="Sondages, nuages de mots et quiz en direct dans vos diapos." />
  <IconUrl DefaultValue="https://sondage.baratextile.com/addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://sondage.baratextile.com/addin/icon-64.png" />
  <SupportUrl DefaultValue="https://sondage.baratextile.com/" />
  <AppDomains>
    <AppDomain>https://sondage.baratextile.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://sondage.baratextile.com/addin/" />
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
